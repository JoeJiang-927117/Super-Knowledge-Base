# 复制为 .env 后按需填写（外部 API 优先，支持 LLLM / LLM / VM 三类独立接口）
ZHIXU_HOST=127.0.0.1
ZHIXU_PORT=8787
ZHIXU_DATA_DIR=./data
# 模式：cloud (外部 API 优先) | lan_gpu | local
ZHIXU_MODE=cloud
ZHIXU_PROVIDER=openai
ZHIXU_MODEL_BASE_URL=https://api.deepseek.com/v1
ZHIXU_API_KEY=
# 三类模型接口（可共享上方主网关，或单独配置 *_BASE_URL / *_API_KEY）
ZHIXU_LLLM_MODEL=deepseek-reasoner
ZHIXU_LLM_MODEL=deepseek-chat
ZHIXU_VISION_MODEL=qwen-vl-max
ZHIXU_EMBEDDING_MODEL=text-embedding-3-small
ZHIXU_RERANK_BASE_URL=
ZHIXU_RERANK_API_KEY=
ZHIXU_RERANK_MODEL=
# 服务端强制鉴权令牌与后台初始管理员
ZHIXU_SERVER_TOKEN=change-me-to-a-strong-secret
ZHIXU_CORS_ORIGIN=
ZHIXU_ADMIN_USER=zhixu
ZHIXU_ADMIN_PASSWORD=123456789
