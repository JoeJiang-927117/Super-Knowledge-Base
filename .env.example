# Copy to .env and fill in required secrets before running server or Docker Compose.
# Minimal required variables for Docker: ZHIXU_ADMIN_PASSWORD (>= 12 chars) + ZHIXU_API_KEY.

# === Server & Storage ===
ZHIXU_HOST=127.0.0.1
ZHIXU_PORT=8787
# Standalone Node server data directory:
ZHIXU_ROOT=./data
# Docker Compose host directory mounted into container /data/knowledge-base:
ZHIXU_HOST_DATA_DIR=./data

# === Authentication & Security ===
# Initial superadmin username & strong password (min 12 chars, letters + digits/symbols).
# On non-loopback binds (e.g. Docker 0.0.0.0), startup refuses if unset or weak.
ZHIXU_ADMIN_USER=zhixu
ZHIXU_ADMIN_PASSWORD=
# Optional fixed Bearer automation token (leave blank to auto-generate a 256-bit random token)
ZHIXU_SERVER_TOKEN=
# Optional comma-separated CORS allowlist (defaults to localhost loopback only)
ZHIXU_CORS_ORIGIN=

# === Model Routing (cloud | lan_gpu | local) ===
ZHIXU_MODE=cloud
ZHIXU_PROVIDER=openai
ZHIXU_MODEL_BASE_URL=https://api.deepseek.com/v1
ZHIXU_API_KEY=

# Optional independent tier endpoints (*_BASE_URL / *_API_KEY)
ZHIXU_LLLM_MODEL=deepseek-reasoner
ZHIXU_LLM_MODEL=deepseek-chat
ZHIXU_VISION_MODEL=qwen-vl-max
ZHIXU_EMBEDDING_MODEL=text-embedding-3-small
ZHIXU_RERANK_BASE_URL=
ZHIXU_RERANK_API_KEY=
ZHIXU_RERANK_MODEL=
